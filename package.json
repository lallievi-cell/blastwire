{
  "name": "blastwire",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "BLASTWIRE — Tactical Demolition Roguelite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "npm run build && rm -rf assets art && cp -r dist/assets ./assets && cp -r dist/art ./art && cp dist/index.html ./index.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
